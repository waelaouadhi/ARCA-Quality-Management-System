generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// =======================
// ENUMS
// =======================
//

enum Role {
  ADMIN
  MANAGER
  USER
}

enum DocStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NCStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  PLANNED
  REJECTED
}

enum DashboardMetricType {
  COUNT
  PERCENTAGE
  TREND
  RATIO
}

enum EscalationLevel {
  NONE
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

enum EscalationStatus {
  NONE
  ACTIVE
  RESOLVED
  PAUSED
}

enum NotificationChannel {
  EMAIL
  IN_APP
  WEBSOCKET
  SMS
  SLACK
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

//
// =======================
// USER MODULE
// =======================
//

model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  firstName String
  lastName  String
  role      Role   @default(USER)

  documents               Document[]
  audits                  AuditLog[]
  reportedNonConformances NonConformance[]   @relation("ReportedBy")
  assignedActions         CorrectiveAction[] @relation("AssignedTo")

  // Phase 1: RBAC relations
  userPermissions UserPermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// =======================
// DOCUMENT CONTROL MODULE
// =======================
//

model Document {
  id      String    @id @default(cuid())
  title   String
  content String?
  version Int       @default(1)
  status  DocStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// =======================
// NON CONFORMANCE MODULE
// =======================
//

model NonConformance {
  id          String    @id @default(cuid())
  title       String
  description String
  severity    Severity  @default(MEDIUM)
  status      NCStatus  @default(OPEN)
  dueDate     DateTime?

  reportedById String
  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id])

  correctiveActions CorrectiveAction[]
  escalation        NonConformanceEscalation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity])
  @@index([status])
  @@index([dueDate])
}

//
// =======================
// CORRECTIVE ACTION MODULE
// =======================
//

model CorrectiveAction {
  id     String       @id @default(cuid())
  action String
  status ActionStatus @default(PENDING)

  nonConformanceId String
  nonConformance   NonConformance @relation(fields: [nonConformanceId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTo", fields: [assignedToId], references: [id])

  dueDate    DateTime?
  escalation CorrectiveActionEscalation?

  // Phase 1 Enhancement: 2-stage CAPA workflow
  capaNumber           String?           // Unique CAPA identifier (e.g., "CAPA-2024-001")
  requestStatus        RequestStatus?    // Request approval stage (PENDING → ACCEPTED → PLANNED)
  rootCauseAnalysis    String?           // Required before action can proceed
  rootCauseAnalyzedAt  DateTime?         // When RCA was completed
  rootCauseAnalyzedBy  String?           // User ID who analyzed root cause
  completedAt          DateTime?         // When action was completed
  completedBy          String?           // User ID who completed
  verifiedAt           DateTime?         // When action was verified
  verifiedBy           String?           // User ID who verified
  verificationNotes    String?           // Notes from verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([capaNumber])
  @@index([status])
  @@index([requestStatus])
  @@index([dueDate])
  @@index([assignedToId])
  @@index([capaNumber])
}

//
// =======================
// AUDIT LOG MODULE
// =======================
//

model AuditLog {
  id String @id @default(cuid())

  action   String
  entity   String
  entityId String

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

//
// =======================
// ESCALATION MODULE
// =======================
//

/**
 * SLA Rules for escalation timing
 * Database-driven configuration
 */
model SLARule {
  id String @id @default(cuid())

  // Rule identification
  name        String  @unique
  description String?

  // Scope
  severity     Severity
  departmentId String? // Optional: for department-specific SLAs

  // Escalation config
  escalationLevels EscalationLevel[] @default([LEVEL_1, LEVEL_2, LEVEL_3])

  // Timing (in hours)
  level1DelayHours Int @default(0) // Immediate to Level 1
  level2DelayHours Int @default(24) // Level 2 after X hours
  level3DelayHours Int @default(48) // Level 3 after Y hours

  // Recipients
  level1Recipients String[] @default([]) // Assigned user + manager
  level2Recipients String[] @default([]) // Manager + admin
  level3Recipients String[] @default([]) // Admin only

  // Notification config
  notifyChannels NotificationChannel[] @default([EMAIL, IN_APP])

  // Relations
  ncEscalations NonConformanceEscalation[]
  caEscalations CorrectiveActionEscalation[]

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity])
  @@index([departmentId])
  @@index([isActive])
}

/**
 * Escalation state for NonConformance
 */
model NonConformanceEscalation {
  id String @id @default(cuid())

  nonConformanceId String         @unique
  nonConformance   NonConformance @relation(fields: [nonConformanceId], references: [id], onDelete: Cascade)

  // Current escalation state
  currentLevel     EscalationLevel  @default(NONE)
  escalationStatus EscalationStatus @default(NONE)

  // Timing
  isOverdue        Boolean   @default(false)
  overdueAt        DateTime?
  lastEscalatedAt  DateTime?
  nextEscalationAt DateTime?

  // SLA reference
  appliedSLARuleId String?
  appliedSLARule   SLARule? @relation(fields: [appliedSLARuleId], references: [id])

  // Escalation chain tracking
  level1NotifiedAt DateTime?
  level2NotifiedAt DateTime?
  level3NotifiedAt DateTime?

  // Acknowledgment tracking
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escalationHistory EscalationHistory[]

  @@index([nonConformanceId])
  @@index([escalationStatus])
  @@index([isOverdue])
  @@index([nextEscalationAt])
}

/**
 * Escalation state for CorrectiveAction
 */
model CorrectiveActionEscalation {
  id String @id @default(cuid())

  correctiveActionId String           @unique
  correctiveAction   CorrectiveAction @relation(fields: [correctiveActionId], references: [id], onDelete: Cascade)

  // Current escalation state
  currentLevel     EscalationLevel  @default(NONE)
  escalationStatus EscalationStatus @default(NONE)

  // Timing
  isOverdue        Boolean   @default(false)
  overdueAt        DateTime?
  lastEscalatedAt  DateTime?
  nextEscalationAt DateTime?

  // SLA reference
  appliedSLARuleId String?
  appliedSLARule   SLARule? @relation(fields: [appliedSLARuleId], references: [id])

  // Escalation chain tracking
  level1NotifiedAt DateTime?
  level2NotifiedAt DateTime?
  level3NotifiedAt DateTime?

  // Acknowledgment tracking
  acknowledgedAt DateTime?
  acknowledgedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  escalationHistory EscalationHistory[]

  @@index([correctiveActionId])
  @@index([escalationStatus])
  @@index([isOverdue])
  @@index([nextEscalationAt])
}

/**
 * Audit trail for all escalation events
 */
model EscalationHistory {
  id String @id @default(cuid())

  // Escalation context
  ncEscalationId String?
  ncEscalation   NonConformanceEscalation? @relation(fields: [ncEscalationId], references: [id], onDelete: Cascade)

  caEscalationId String?
  caEscalation   CorrectiveActionEscalation? @relation(fields: [caEscalationId], references: [id], onDelete: Cascade)

  // Event details
  eventType       String // e.g., "OVERDUE_DETECTED", "ESCALATED_TO_LEVEL_2", "ACKNOWLEDGED"
  escalationLevel EscalationLevel
  reason          String?

  // Who triggered this
  triggeredBy String? // system, user email, etc.

  // Notification details
  notificationsId String[] @default([]) // References to Notification records

  createdAt DateTime @default(now())

  @@index([ncEscalationId])
  @@index([caEscalationId])
  @@index([eventType])
  @@index([createdAt])
}

/**
 * Notification record for audit and retry tracking
 */
model Notification {
  id String @id @default(cuid())

  // Notification details
  entityType      String // "NonConformance" or "CorrectiveAction"
  entityId        String
  escalationLevel EscalationLevel

  // Recipient
  recipientEmail  String?
  recipientUserId String?

  // Channels
  channels        NotificationChannel[]
  channelStatuses String                @default("{}") // JSON: { "EMAIL": "SENT", "IN_APP": "PENDING" }

  // Retry tracking
  status        NotificationStatus @default(PENDING)
  retryCount    Int                @default(0)
  maxRetries    Int                @default(3)
  lastRetryAt   DateTime?
  nextRetryAt   DateTime?
  failureReason String?

  // Idempotency
  idempotencyKey String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  @@index([entityType, entityId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([idempotencyKey])
}

//
// =======================
// RBAC MODULE (PHASE 1)
// =======================
//

/**
 * Fine-grained permission definitions
 * Format: "resource:action" (e.g., "document:approve", "nonConformance:assign")
 */
model Permission {
  id String @id @default(cuid())

  // Permission identifier
  resource String // e.g., "document", "nonConformance"
  action   String // e.g., "create", "approve", "assign"

  // Description for UI
  name        String  @unique // e.g., "document:approve"
  description String?

  // Category for grouping in UI
  category String @default("general") // "core", "workflow", "admin", "reporting"

  // Status
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@unique([resource, action])
  @@index([resource])
  @@index([isActive])
}

/**
 * Role-to-Permission mapping
 * Defines what permissions each role has by default
 */
model RolePermission {
  id String @id @default(cuid())

  // Role association
  role Role // ADMIN, MANAGER, USER

  // Permission reference
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([role, permissionId])
  @@index([role])
}

/**
 * User-specific permission overrides
 * Allows granting/denying specific permissions to users beyond their role
 */
model UserPermission {
  id String @id @default(cuid())

  // User association
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Permission reference
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  // Grant or deny
  granted Boolean @default(true) // true=grant, false=deny (deny overrides role permissions)

  // Reason/context
  reason    String?
  grantedBy String? // admin user ID
  grantedAt DateTime  @default(now())
  expiresAt DateTime? // Permission can expire

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([granted])
}

//
// =======================
// DASHBOARD MODULE (PHASE 1)
// =======================
//

/**
 * Pre-computed dashboard metrics
 * Updated by background jobs for performance
 */
model DashboardMetric {
  id String @id @default(cuid())

  // Metric identification
  metricType DashboardMetricType
  metricKey  String // e.g., "nc_open_count", "ca_overdue_percentage"
  name       String // e.g., "Open Non-Conformances"

  // Time period
  periodStartDate DateTime
  periodEndDate   DateTime

  // Values
  value         Float
  previousValue Float? // For trending
  target        Float? // KPI target

  // Breakdown (optional JSON)
  breakdown String? // JSON: { "by_severity": {...}, "by_department": {...} }

  // Refresh tracking
  lastComputedAt  DateTime @default(now())
  refreshInterval Int      @default(3600) // seconds

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([metricKey, periodStartDate, periodEndDate])
  @@index([metricType])
  @@index([lastComputedAt])
}
