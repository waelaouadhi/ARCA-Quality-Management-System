# =============================================================================
# QMS Backend - Environment Configuration
# 
# Copy this file to .env and update all values for your environment
# For production, use STRONG values with 32+ character JWT_SECRET
# 
# SECURITY NOTE: Never commit .env to version control
# =============================================================================

# APPLICATION CONFIGURATION
NODE_ENV=development
PORT=4000
APP_NAME=QMS-Backend

# DATABASE CONFIGURATION
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:mypassword@localhost:5432/qms_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/qms_db

# JWT SECURITY CONFIGURATION
# ⚠️  SECURITY CRITICAL - Must meet requirements:
#   • Minimum 32 characters (256 bits)
#   • Mix of uppercase, lowercase, numbers, special characters
#   • Change this value in production - DO NOT use default
#   • Use: openssl rand -base64 32 to generate secure secrets
# 
# ❌ DEVELOPMENT (DO NOT USE IN PRODUCTION):
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# 
# ✅ PRODUCTION (Example with strong secret):
# JWT_SECRET=K7$mP@nQ9vL2xR#bJ4cD8eF5g!H3iW6zY1tU0
JWT_SECRET=development-key-only-32chars-minimum-12345
JWT_EXPIRES_IN=7d

# CORS CONFIGURATION
# Specify allowed origin for cross-origin requests
# For development: http://localhost:3000
# For production: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# LOGGING CONFIGURATION
LOG_LEVEL=info

# OPTIONAL - EMAIL/NOTIFICATIONS (if using SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================
# 
# Development:
#   1. Copy to .env: cp .env.example .env
#   2. Leave defaults for development database
#   3. Run: npm run dev
# 
# Production (Docker):
#   1. Set NODE_ENV=production
#   2. Generate JWT_SECRET: openssl rand -base64 32
#   3. Set DATABASE_URL to production PostgreSQL
#   4. Set CORS_ORIGIN to production domain
#   5. Build: docker build -t qms-backend .
#   6. Run: docker run -e NODE_ENV=production -e JWT_SECRET=... qms-backend
# 
# Production (Standalone):
#   1. Set all environment variables before starting
#   2. Run: npm run build
#   3. Run: npm start
# 
# ⚠️  Application WILL NOT START if required variables are missing or invalid
# ✅ Validation runs on startup to catch configuration errors early
# =============================================================================

